# OpenAI-compatible chat completions API.
# Point this at the Grok endpoint your Cursor key belongs to.
# xAI's Grok API: https://api.x.ai/v1
CURSOR_BASE_URL=https://api.x.ai/v1
CURSOR_API_KEY=
CURSOR_MODEL=grok-4

# auto = live when CURSOR_API_KEY is set, otherwise a scripted local model
# live | mock | auto
LLM_MODE=auto

HOST_A_ENDPOINT=http://127.0.0.1:7701
HOST_B_ENDPOINT=http://127.0.0.1:7702
DAEMON_IMAGE=coding-agent-daemon:local
BACKEND_PORT=8080
SUPERVISOR_PORT=8090
MAX_ROUNDS=30
